# docker compose 가 읽는 비밀값. 이 파일을 .env 로 복사해 값을 채운다(.env 는 커밋 금지).
JWT_SECRET=                 # 회원 토큰 서명 키(64자 이상 무작위)
ADMIN_JWT_SECRET=           # (선택) 관리자 토큰 서명 키. 비우면 JWT_SECRET 에서 파생한 별도 키 사용
JWT_EXPIRES_IN=30d
MONGO_ROOT_PASSWORD=        # Mongo root 비밀번호
MONGO_URI=                  # mongodb://admin:<URL 인코딩한 비밀번호>@mongo:27017/empecs_cgms?authSource=admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=             # 관리자 계정이 하나도 없을 때 최초 최고관리자 비밀번호(첫 로그인 때 변경 필수). 비우면 무작위 생성 후 로그에 1회 출력
